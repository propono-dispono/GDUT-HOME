# 校集后端生产环境变量模板
# 实际文件：/opt/xiaojii/.env（权限 600，只有 root 可读）
# ⚠️ 不要把真实值提交到仓库，也不要发到聊天里

# ---- 端口 ----
XIAOJII_PORT=8081

# ---- MySQL（容器网络内用容器名；若用 host 网络改成 127.0.0.1:3307）----
DB_URL=jdbc:mysql://MySQL8.0:3306/xiaojii?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_HOST=Redis7
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT（生产必须换，32 字节以上；生成命令：openssl rand -base64 48）----
JWT_SECRET=CHANGE_ME

# ---- 微信小程序（正式号 wx93309d649e66dc53）----
WX_APPID=wx93309d649e66dc53
WX_SECRET=CHANGE_ME
# 上线必须是 false：否则任何人传 openid 就能登录任意账号
WX_DEV_LOGIN=false

# ---- 上传 ----
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_BASE=https://xj.sxz-blog.xyz/api/files

# ---- 其他 ----
TZ=Asia/Shanghai
AUDIT_MACHINE_ENABLED=false
