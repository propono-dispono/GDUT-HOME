<!-- list页 —— 页面结构 -->
<import src="../../templates/card.wxml" />

<view class="app">

  <view class="appbar" style="height:{{appbarH}}px;padding-top:{{safeTop}}px;padding-right:{{capsuleRight}}px">
    <view class="iconbtn" hover-class="iconbtn-hv" bindtap="onBack">
      <view class="ic ic-i-back"></view>
    </view>
    <text class="appbar-title">{{bizTitle}}</text>
  </view>

  <view class="filterbar">
    <view
      class="f {{sort === item.k ? 'f--on' : ''}}"
      wx:for="{{sorts}}"
      wx:key="k"
      data-k="{{item.k}}"
      bindtap="onSort"
    >{{item.t}}</view>
    <text class="filterbar-count">{{count}} 条</text>
  </view>

  <scroll-view class="app-main" scroll-y enable-flex>
    <view class="feed">
      <block wx:if="{{list.length > 0}}">
        <template is="card" wx:for="{{list}}" wx:key="id" data="{{item: item}}" />
      </block>

      <view class="empty" wx:elif="{{loading}}">
        <view class="empty-title">加载中…</view>
      </view>

      <view class="empty" wx:else>
        <view class="empty-ico"><view class="ic ic-i-inbox ic--lg"></view></view>
        <view class="empty-title">{{errMsg || '没有找到相关内容'}}</view>
        <view class="empty-desc">换个分类或关键词试试</view>
      </view>
    </view>
  </scroll-view>

</view>
