<!-- 通知 —— 页面结构 -->
<view class="app">

  <view class="appbar" style="height:{{appbarH}}px;padding-top:{{safeTop}}px;padding-right:{{capsuleRight}}px">
    <view class="iconbtn" hover-class="iconbtn-hv" bindtap="onBack">
      <view class="ic ic-i-back"></view>
    </view>
    <text class="appbar-title">通知详情</text>
  </view>

  <scroll-view class="app-main" scroll-y enable-flex>

    <view wx:if="{{notice}}" class="notice">
      <text class="notice-tag {{notice.type === 'AUDIT' ? 'notice-tag--audit' : ''}}">{{notice.typeText}}</text>
      <view class="notice-title">{{notice.title}}</view>
      <view class="notice-time">{{notice.createdAt}}</view>
      <view class="notice-body">{{notice.content || '这条通知没有正文'}}</view>
      <view wx:if="{{notice.content}}" class="notice-actions">
        <view class="btn btn--ghost btn--sm" hover-class="btn-hv" bindtap="onCopy">复制内容</view>
      </view>
    </view>

    <view wx:else class="empty">
      <view class="empty-ico"><view class="ic ic-i-bell ic--lg"></view></view>
      <view class="empty-title">通知不存在或已过期</view>
      <view class="empty-desc">请从消息列表重新进入</view>
    </view>

  </scroll-view>

</view>
