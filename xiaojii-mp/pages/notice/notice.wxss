.notice {
  padding: var(--s4) var(--gutter) var(--s8);
}

.notice-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--fs-11);
  color: var(--ink-3);
  background: var(--surface-2);
}
.notice-tag--audit {
  color: #7A5B12;
  background: #FAF0D8;
}

.notice-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: var(--fw-bold);
  line-height: 1.45;
  color: var(--ink);
  word-break: break-word;
}

.notice-time {
  margin-top: 12rpx;
  font-size: var(--fs-11);
  color: var(--ink-4);
}

.notice-body {
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--line);
  font-size: var(--fs-14);
  line-height: 1.9;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: flex-start;
}
