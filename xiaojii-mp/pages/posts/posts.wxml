<!-- posts页 —— 页面结构 -->
<view class="app">

  <view class="appbar" style="height:{{appbarH}}px;padding-top:{{safeTop}}px;padding-right:{{capsuleRight}}px">
    <view class="iconbtn" hover-class="iconbtn-hv" bindtap="onBack">
      <view class="ic ic-i-back"></view>
    </view>
    <text class="appbar-title">我的发布</text>
  </view>

  <scroll-view class="app-main" scroll-y enable-flex>

    <view class="posts-list" wx:if="{{list.length > 0}}">
      <view
        class="posts-row"
        wx:for="{{list}}"
        wx:key="id"
        hover-class="rowlink-hv"
        data-id="{{item.id}}"
        bindtap="onTap"
      >
        <view class="grow">
          <view class="posts-title ellipsis">{{item.title}}</view>
          <view class="posts-meta">
            <text class="posts-biz">{{item._short}}</text>
            <text class="text-3">{{item.meta}}</text>
          </view>
          <view class="posts-reason" wx:if="{{item.rejectReason}}">原因：{{item.rejectReason}}</view>
        </view>
        <view class="posts-status posts-status--{{item._st}}">{{item.statusText}}</view>
      </view>
    </view>

    <view class="empty" wx:elif="{{loading}}">
      <view class="empty-title">加载中…</view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-ico"><view class="ic ic-i-inbox ic--lg"></view></view>
      <view class="empty-title">{{errMsg || '还没有发布过内容'}}</view>
      <view class="empty-desc">发布后会显示在这里，含审核状态</view>
      <view class="btn btn--primary btn--sm mt-4" bindtap="onGoPublish">去发布</view>
    </view>

  </scroll-view>

</view>
