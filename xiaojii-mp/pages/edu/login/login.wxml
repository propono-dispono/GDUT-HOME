<!-- 登录 —— 页面结构 -->
<view class="app">

  <view class="appbar" style="height:{{appbarH}}px;padding-top:{{safeTop}}px;padding-right:{{capsuleRight}}px">
    <view class="iconbtn" hover-class="iconbtn-hv" bindtap="onBack">
      <view class="ic ic-i-back"></view>
    </view>
    <text class="appbar-title">教务登录</text>
  </view>

  <scroll-view class="app-main" scroll-y enable-flex>

    <view class="edu-head">
      <view class="edu-head-title">登录广工教务</view>
      <view class="edu-head-desc">使用学号登录广东工业大学统一身份认证，登录后可查看课表、成绩与考试安排</view>
    </view>

    <view class="field">
      <view class="field-label">学号 <text class="req">*</text></view>
      <input
        class="field-control"
        value="{{account}}"
        maxlength="32"
        placeholder="教务系统学号"
        placeholder-class="ph"
        bindinput="onAccount"
      />
    </view>

    <view class="field">
      <view class="field-label">密码 <text class="req">*</text></view>
      <view class="edu-inline">
        <input
          class="edu-input"
          password="{{!showPwd}}"
          value="{{password}}"
          maxlength="64"
          placeholder="教务系统密码"
          placeholder-class="ph"
          bindinput="onPassword"
          confirm-type="done"
          bindconfirm="onSubmit"
        />
        <text class="edu-pwd-toggle" bindtap="onTogglePwd">{{showPwd ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <view class="field">
      <view class="edu-remember" bindtap="onToggleRemember">
        <view class="edu-check {{remember ? 'is-checked' : ''}}">
          <text wx:if="{{remember}}">✓</text>
        </view>
        <view class="grow">
          <view class="edu-remember-label">记住密码（30 天免登录）</view>
          <view class="field-hint">密码加密保存在服务端，仅用于自动刷新课表；取消勾选则每次都要重新登录</view>
        </view>
      </view>
    </view>

    <view wx:if="{{errMsg}}" class="edu-error">{{errMsg}}</view>

    <view class="edu-actions">
      <view
        class="btn btn--primary btn--block {{submitting ? 'is-disabled' : ''}}"
        hover-class="btn-hv"
        bindtap="onSubmit"
      >{{submitting ? '登录中…' : '登录教务'}}</view>
    </view>

    <view class="edu-note">
      密码加密传输给学校教务系统。勾选「记住密码」后，GDUT-HOME 会加密保存你的账号密码用于 30 天内自动刷新课表；不勾选则密码只在本次登录使用。任何情况下都不会把你的账号用于其他用途，可随时在教务中心退出并删除。
    </view>

  </scroll-view>

</view>
