/* 教务登录页 · 仅补充全局样式未覆盖的部分，色板沿用 app.wxss 变量 */

.edu-head {
  padding: var(--s5) var(--gutter) var(--s4);
  background: var(--surface);
}

.edu-head-title {
  font-size: var(--fs-20);
  font-weight: var(--fw-bold);
  letter-spacing: -.01em;
}

.edu-head-desc {
  margin-top: 8rpx;
  font-size: var(--fs-13);
  color: var(--ink-3);
}

.edu-inline {
  display: flex;
  align-items: center;
  gap: var(--s3);
}

.edu-input {
  flex: 1;
  min-width: 0;
  min-height: 48rpx;
  font-size: var(--fs-15);
  color: var(--ink);
}

.edu-pwd-toggle {
  flex: 0 0 auto;
  padding: 0 var(--s1);
  font-size: var(--fs-12);
  color: var(--ink-3);
}

.edu-captcha {
  flex: 0 0 auto;
  width: 200rpx;
  height: 76rpx;
  display: grid;
  place-items: center;
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  overflow: hidden;
}

.edu-captcha-img {
  width: 100%;
  height: 100%;
}

.edu-captcha-ph {
  font-size: var(--fs-12);
  color: var(--ink-3);
}

.edu-remember {
  display: flex;
  align-items: center;
  gap: var(--s3);
}

.edu-remember-label {
  font-size: var(--fs-14);
  color: var(--ink);
}

/* 记住密码的勾选框 */
.edu-check {
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  box-sizing: border-box;
  border-radius: 6px;
  border: 1.5px solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  line-height: 1;
  color: #fff;
}

.edu-check.is-checked {
  background: var(--accent);
  border-color: var(--accent);
}

.edu-error {
  margin: var(--s3) var(--gutter) 0;
  padding: var(--s2) var(--s3);
  border-radius: var(--r-sm);
  background: var(--accent-weak);
  color: var(--accent-text);
  font-size: var(--fs-13);
}

.edu-actions {
  padding: var(--s4) var(--gutter) 0;
}

.edu-note {
  padding: var(--s3) var(--gutter) var(--s6);
  font-size: var(--fs-11);
  line-height: 1.7;
  color: var(--ink-4);
}
